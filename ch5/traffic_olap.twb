      <column caption='Broj vozila' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3039641071382528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([motion_id])' />
      </column>
      <column caption='Broj marki' datatype='integer' name='[Calculation_3039641080328193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [brand] &lt;&gt; &apos;unknown&apos; THEN [brand] END)' />
      </column>
      <column caption='Tip vozila' datatype='string' name='[Calculation_3039641149063170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vehicle_class] IN (&apos;bicycle&apos;,&apos;scooter&apos;,&apos;motorcycle&apos;) THEN &apos;Dvokotači&apos;&#10;ELSEIF [vehicle_class] = &apos;car&apos; THEN &apos;Osobni automobili&apos;&#10;ELSE &apos;Gospodarska i ostala&apos;&#10;END' />
      </column>
      <column caption='Udio suprotnog smjera' datatype='real' default-format='p0.0%' name='[Calculation_3039641191608323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [direction] = &apos;left&apos; THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Marka nepoznata' datatype='real' default-format='p0.0%' name='[Calculation_3039641211437060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [brand] = &apos;unknown&apos; THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Era nedostupna' datatype='real' default-format='p0.0%' name='[Calculation_3039641211482117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF ISNULL([era]) THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Boja nepoznata' datatype='real' default-format='p0.0%' name='[Calculation_3039641211539462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [color] = &apos;unknown&apos; THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Tablica vidljiva' datatype='real' default-format='p0.0%' name='[Calculation_3039641211588615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [plate_visible] THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Body nedostupan' datatype='real' default-format='p0.0%' name='[Calculation_3039641211637768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF ISNULL([body]) THEN [motion_id] END) / COUNT([motion_id])' />
      </column>
      <column caption='Preklapajuce razdoblje' datatype='boolean' name='[Calculation_3039641212755977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[full_date] &lt;= #2026-08-27#' />
      </column>
